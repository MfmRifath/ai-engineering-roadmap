# Normalize line endings: LF in the repo, native in the working tree.
* text=auto eol=lf

# Windows-native files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text
*.pdf binary
*.pt binary
*.pth binary
*.safetensors binary
*.gguf binary

# Notebooks: keep diffs readable, treat as text
*.ipynb text

# Generated — collapse in PR diffs
PROGRESS.md linguist-generated=true
books/_toc/*.txt linguist-generated=true
flashcards/*.tsv linguist-generated=true

# GitHub language stats: this is a learning repo, count the notes
*.md linguist-documentation=false
