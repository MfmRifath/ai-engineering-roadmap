# Copy to .env and fill in. .env is gitignored; .env.example is not.
# Never commit real keys — see Huyen ch5 on treating prompts and config as code.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# Local models (Ollama / llama.cpp) — no key needed
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# Defaults used by the projects
AIENG_DEFAULT_MODEL=claude-sonnet-4-5
AIENG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
AIENG_MAX_COST_USD=1.00
